// Port lại UnityConvertShader của PLA gốc: unlit (không nhận ánh sáng), texture + chỉnh màu
// (brightness / saturation / contrast / gamma), có pass planar-shadow để đổ bóng phẳng xuống mặt đất.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: unlit-vs:vert
      frag: unlit-fs:frag
      properties: &props
        mainTexture:      { value: white }
        mainColor:        { value: [1, 1, 1, 1], editor: { type: color } }
        tilingOffset:     { value: [1, 1, 0, 0] }
        brightness:       { value: 1.05, target: gradeParams.x }
        saturation:       { value: 1.2,  target: gradeParams.y }
        contrast:         { value: 1.1,  target: gradeParams.z }
        gammaValue:       { value: 5.0,  target: gradeParams.w, editor: { parent: USE_GAMMA } }
        diffuseThreshold: { value: 0.5,  target: diffuseParams.x, editor: { tooltip: 'Pixel có cả 3 kênh nhỏ hơn ngưỡng này thì nhân với diffuseFactor' } }
        diffuseFactor:    { value: 0.2,  target: diffuseParams.y }
        cutoff:           { value: 0.5,  target: diffuseParams.z, editor: { parent: USE_ALPHA_TEST, tooltip: 'Alpha nhỏ hơn thì bỏ pixel' } }
    - &planar-shadow
      vert: planar-shadow-vs:vert
      frag: planar-shadow-fs:frag
      phase: planar-shadow
      propertyIndex: 0
      depthStencilState:
        depthTest: true
        depthWrite: false
        stencilTestFront: true
        stencilFuncFront: not_equal
        stencilPassOpFront: replace
        stencilRef: 0x80 # only use the leftmost bit
        stencilReadMask: 0x80
        stencilWriteMask: 0x80
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
}%

CCProgram unlit-vs %{
  // Vertex gọn như builtin-unlit: chỉ vị trí + UV (+ fog). Không tính normal/tangent/ma trận nghịch đảo
  // như general-vs vì shader unlit không dùng -> nhẹ hơn nhiều với ~300k tris block trên màn hình.
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec2 v_uv;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    v_uv = a_texCoord;
    CC_TRANSFER_FOG(matWorld * position);
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram unlit-fs %{
  precision highp float;
  #include <legacy/output>
  #include <legacy/fog-fs>

  in vec2 v_uv;

  uniform sampler2D mainTexture;
  uniform Constant {
    vec4 mainColor;
    vec4 tilingOffset;
    vec4 gradeParams;   // x: brightness, y: saturation, z: contrast, w: gamma
    vec4 diffuseParams; // x: threshold, y: factor, z: alpha cutoff
  };

  vec4 frag () {
    vec2 uv = v_uv * tilingOffset.xy + tilingOffset.zw;
    vec4 color = texture(mainTexture, uv) * mainColor;

    color.rgb *= gradeParams.x;
    float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    color.rgb = mix(vec3(gray), color.rgb, gradeParams.y);
    color.rgb = (color.rgb - 0.5) * gradeParams.z + 0.5;
    // gamma = 1 thì pow không đổi gì -> chỉ tính khi bật USE_GAMMA (block đều dùng gamma 1).
    #if USE_GAMMA
      color.rgb = pow(max(color.rgb, vec3(0.0)), vec3(1.0 / gradeParams.w));
    #else
      color.rgb = max(color.rgb, vec3(0.0));
    #endif
    if (all(lessThan(color.rgb, vec3(diffuseParams.x)))) {
      color.rgb *= diffuseParams.y;
    }
    // discard làm GPU di động tắt early-Z (mọi lớp bị che vẫn phải tô) -> chỉ bật khi texture thật sự có alpha cắt.
    #if USE_ALPHA_TEST
      if (color.a < diffuseParams.z) discard;
    #endif

    CC_APPLY_FOG(color);
    return CCFragOutput(color);
  }
}%

CCProgram planar-shadow-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <builtin/uniforms/cc-shadow>
  #include <common/lighting/functions>

  out float v_dist;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);
    vec3 worldPos = (matWorld * position).xyz;
    vec4 shadowPos = CalculatePlanarShadowPos(worldPos, cc_cameraPos.xyz, cc_mainLitDir.xyz, cc_planarNDInfo);
    position = CalculatePlanarShadowClipPos(shadowPos, cc_cameraPos.xyz, cc_matView, cc_matProj, cc_nearFar, cc_shadowWHPBInfo.w);
    v_dist = shadowPos.w;
    return position;
  }
}%

CCProgram planar-shadow-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-shadow>
  #include <legacy/output>

  in float v_dist;

  vec4 frag () {
    if(v_dist < 0.0)
      discard;
    return CCFragOutput(cc_shadowColor);
  }
}%
