// Ground có lỗ: vẽ như ground bình thường (texture + ánh sáng + nhận bóng),
// riêng các pixel nằm trong hình tròn quanh tâm hố thì bỏ đi -> trong suốt, nhìn xuyên xuống dưới.
// holeCenter / holeRadius do script GroundHole cập nhật theo node Hole.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: hole-vs
      frag: hole-fs
      properties:
        mainTexture:  { value: white }
        mainColor:    { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        tilingOffset: { value: [1, 1, 0, 0] }
        holeCenter:   { value: [0, 0], target: holeParams.xy, editor: { tooltip: 'Tâm lỗ (world X, Z)' } }
        holeRadius:   { value: 3, target: holeParams.z, editor: { tooltip: 'Bán kính lỗ (world)' } }
}%

CCProgram shared-ubos %{
  uniform Constants {
    vec4 mainColor;
    vec4 tilingOffset;
    vec4 holeParams; // xy: tâm lỗ (world XZ), z: bán kính
  };
}%

CCProgram surface-vertex %{
  #define CC_SURFACES_VERTEX_MODIFY_UV
  void SurfacesVertexModifyUV(inout SurfacesStandardVertexIntermediate In)
  {
    In.texCoord = In.texCoord * tilingOffset.xy + tilingOffset.zw;
  }
}%

CCProgram surface-fragment %{
  uniform sampler2D mainTexture;

  #define CC_SURFACES_FRAGMENT_MODIFY_BASECOLOR_AND_TRANSPARENCY
  vec4 SurfacesFragmentModifyBaseColorAndTransparency()
  {
    // Trong lỗ: bỏ pixel.
    if (distance(FSInput_worldPos.xz, holeParams.xy) < holeParams.z) discard;

    vec4 texColor = texture(mainTexture, FSInput_texcoord);
    texColor.rgb = SRGBToLinear(texColor.rgb);
    return mainColor * texColor;
  }
}%

CCProgram hole-vs %{
  precision highp float;
  #include <surfaces/effect-macros/common-macros>
  #include <surfaces/includes/common-vs>
  #include <shared-ubos>
  #include <surface-vertex>
  #include <surfaces/includes/standard-vs>
  #include <shading-entries/main-functions/render-to-scene/vs>
}%

CCProgram hole-fs %{
  precision highp float;
  #include <surfaces/effect-macros/common-macros>
  #include <surfaces/includes/common-fs>
  #include <shared-ubos>
  #include <surface-fragment>
  #include <lighting-models/includes/standard>
  #include <surfaces/includes/standard-fs>
  #include <shading-entries/main-functions/render-to-scene/fs>
}%
